import serial
import time

ser = serial.Serial('/dev/ttyACM0', 115200, timeout=1)

time.sleep(3)

ser.reset_input_buffer()

print("serialTransceiver: Serial port opened and ready to communicate.")


try:
    while True: 

        #print("new loop iteration")
        time.sleep(0.1)
        command = input("Enter command to send to Arduin0 [RPM],[angle],[challenge]: ")

        command = command + '\n'  # add newline character to the end of the command

        ser.write(command.encode('utf-8'))  # send data to Arduino

except KeyboardInterrupt:       # to close the connection when keyboard interrupt
    ser.close()
